{
  "name": "shelveshub",
  "version": "0.2.0",
  "private": true,
  "description": "Official installation and management service for Deck Shelves",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/setup.mjs --update",
    "build": "cargo build",
    "build:release": "cargo build --release",
    "build:deck": "bash scripts/deck-build.sh",
    "build:arm64": "SHELVES_ARCH=aarch64 bash scripts/deck-build.sh",
    "check": "cargo check",
    "test": "cargo test",
    "lint": "cargo clippy -- -D warnings",
    "lint:js": "eslint --no-warn-ignored --pass-on-unpruned-suppressions .",
    "lint:js:baseline": "eslint --no-warn-ignored --suppress-all .",
    "lint:js:prune": "eslint --no-warn-ignored --prune-suppressions .",
    "fmt": "cargo fmt",
    "run": "cargo run --bin shelveshub",
    "devtools": "cargo run --quiet --bin shelves-devtools --",
    "debug:local": "node scripts/debug-local.mjs",
    "local:run": "dotenv -e .env -- node scripts/local-run.mjs",
    "local:run:reseed": "dotenv -e .env -- node scripts/local-run.mjs --reseed --reload",
    "local:stop": "node scripts/local-run.mjs --stop",
    "local:targets": "dotenv -e .env -- node scripts/local-devtools.mjs targets",
    "local:inject": "dotenv -e .env -- node scripts/local-devtools.mjs inject --bundle bundle/index.js",
    "local:reload": "dotenv -e .env -- node scripts/local-devtools.mjs reload",
    "local:console": "dotenv -e .env -- node scripts/local-devtools.mjs console",
    "local:eval": "dotenv -e .env -- node scripts/local-devtools.mjs eval",
    "deck:deploy": "bash scripts/deck-deploy.sh",
    "deck:tunnel": "bash scripts/deck-tunnel.sh",
    "deck:logs": "bash scripts/deck-logs.sh",
    "build:site": "node scripts/build-site.mjs",
    "report": "node scripts/ci/report.mjs --scope local --harness",
    "report:backfill": "node scripts/ci/backfill-reports.mjs",
    "deck:targets": "dotenv -e .env -- node scripts/deck-devtools.mjs targets",
    "deck:injected": "dotenv -e .env -- node scripts/deck-devtools.mjs probe",
    "deck:inject": "dotenv -e .env -- node scripts/deck-devtools.mjs inject --bundle bundle/index.js",
    "deck:reload": "dotenv -e .env -- node scripts/deck-devtools.mjs reload",
    "deck:console": "dotenv -e .env -- node scripts/deck-devtools.mjs console",
    "deck:reinject": "dotenv -e .env -- node scripts/deck-devtools.mjs eval \"delete window.__SHELVES_HOST__; delete window.__SHELVES_LOADER__\"",
    "deck:probe": "node deckprobe/scripts/py.mjs deckprobe/cli.py probe",
    "deck:probe:rows": "node deckprobe/scripts/py.mjs deckprobe/cli.py probe --mode rows",
    "deck:probe:mount": "node deckprobe/scripts/py.mjs deckprobe/cli.py probe --mode mount",
    "deck:diag": "node deckprobe/scripts/py.mjs deckprobe/cli.py diag list",
    "deck:diag:run": "node deckprobe/scripts/py.mjs deckprobe/cli.py diag run",
    "deck:screenshot": "node deckprobe/scripts/py.mjs deckprobe/cli.py screenshot",
    "deck:perf": "node deckprobe/scripts/py.mjs deckprobe/perf-bench.py",
    "site:screenshot": "node scripts/site/capture-screenshots.mjs",
    "site:shots:hub": "bash scripts/site/capture-hub-screenshots.sh",
    "harness": "bash scripts/harness.sh",
    "harness:docker": "bash scripts/harness-docker.sh",
    "clean": "cargo clean"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
