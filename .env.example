# Example .env for connecting to a Steam Deck or test device.
# Copy to .env (pnpm setup does this) and fill in your values.

# ── Steam Deck SSH connection (used by pnpm deck:* tasks) ──────────────────────
DECK_HOST=deck.local
DECK_USER=deck
DECK_DEPLOY_PATH=/home/deck/shelves-loader-dev
DECK_SSH_KEY=~/.ssh/id_rsa
# Optional: sudo password for remote commands (use with caution). Prefer SSH keys and sudoers config instead of storing a password.
DECK_SUDO_PASS=

# ── CDP / DevTools (same vars the loader and shelves-devtools read) ────────────
# Steam exposes its CEF renderer for remote debugging on this host:port once
# `.cef-enable-remote-debugging` exists and Steam has been restarted. For remote
# Deck debugging, run `pnpm deck:tunnel` and point these at the local tunnel end.
SHELVES_CEF_HOST=127.0.0.1
SHELVES_CEF_PORT=8080
# Substring to pick the renderer target (title or URL). Blank = auto-detect.
SHELVES_TARGET=
# Local port for the SSH tunnel (deck-tunnel.sh): localhost:LOCAL_PORT -> deck:8080
LOCAL_PORT=8080
# Pin the glibc version cargo-zigbuild targets for the Deck binary (optional).
DECK_GLIBC=2.31
