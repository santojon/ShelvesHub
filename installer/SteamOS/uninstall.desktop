[Desktop Entry]
Type=Application
Name=Uninstall ShelvesHub
GenericName=ShelvesHub Uninstaller
Comment=Remove ShelvesHub from your Steam Deck (keeps your shelves settings)
Exec=bash -c "if [ -f ~/.local/share/shelveshub/uninstall.sh ]; then bash ~/.local/share/shelveshub/uninstall.sh; else curl -fsSL https://github.com/santojon/ShelvesHub/releases/latest/download/uninstall-steamos.sh -o /tmp/shelveshub-uninstall.sh && bash /tmp/shelveshub-uninstall.sh; fi; echo; echo Press Enter to close this window ...; read -r _"
Terminal=true
Icon=edit-delete
Categories=Utility;System;
