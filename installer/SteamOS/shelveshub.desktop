[Desktop Entry]
Type=Application
Name=Install ShelvesHub
GenericName=ShelvesHub Installer
Comment=Download and install ShelvesHub for Steam Deck
Exec=bash -c "curl -fsSL https://github.com/santojon/ShelvesHub/releases/latest/download/install-steamos.sh -o /tmp/shelveshub-install.sh && bash /tmp/shelveshub-install.sh; echo; echo Press Enter to close this window ...; read -r _"
Terminal=true
Icon=system-software-install
Categories=Utility;System;
